{
  "name": "@twin/sim",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic discrete-event simulation core for the warehouse digital twin (no DOM, no Node-only APIs).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "license": "MIT",
  "dependencies": {
    "@twin/layout": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  }
}
