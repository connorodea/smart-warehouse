{
  "name": "@twin/viewer",
  "version": "1.0.0",
  "private": true,
  "description": "3D warehouse digital twin viewer (Vue 3 + Vite + TypeScript + Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8088",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --port 8088",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.12",
    "three": "^0.169.0",
    "vue-i18n": "^11.1.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "threejs",
    "vue3",
    "vite",
    "typescript",
    "digital-twin",
    "smart-warehouse",
    "logistics",
    "blender",
    "agv"
  ],
  "author": "Xxcool",
  "license": "MIT"
}
